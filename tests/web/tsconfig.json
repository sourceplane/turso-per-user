{
  "extends": "../../tooling/tsconfig/web.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "../../apps/web/*"
      ],
      "app/*": [
        "../../apps/web/app/*"
      ],
      "lib/*": [
        "../../apps/web/lib/*"
      ],
      "@libsql/client": [
        "../../apps/web/node_modules/@libsql/client"
      ],
      "drizzle-orm": [
        "../../apps/web/node_modules/drizzle-orm"
      ],
      "drizzle-orm/*": [
        "../../apps/web/node_modules/drizzle-orm/*"
      ]
    },
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/**/*.ts"
  ]
}
