# Clerk: the application whose sign-up and sign-in this site uses. Create one
# at https://dashboard.clerk.com and copy its keys (API keys → Next.js). Both,
# or the site builds without Clerk and shows how to connect it. In a deployed
# environment they are the CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY Orun
# secrets (README → Connect Clerk); never commit them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional. Clerk's webhook (user.created) at <site>/webhooks/clerk creates a
# new user's database in the background; its signing secret (README → The
# webhook). Without it the database is created on the user's first visit.
CLERK_WEBHOOK_SECRET=

# Turso: the organization every user's database is created in (README →
# Connect Turso). Read per request; without all four a signed-in user is told
# Turso is not connected yet.
# turso auth api-tokens mint <name>
TURSO_API_TOKEN=
# your personal or organization name
TURSO_ORG=
# the seed database every user's database is created from: turso db create <name>
TURSO_DATABASE_NAME=
# turso group tokens create default
TURSO_GROUP_AUTH_TOKEN=

# Optional. The site's public origin (the Open Graph image's absolute URL);
# the Orun build sets it to the environment's SITE_URL or Worker URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
