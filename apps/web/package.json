{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --webpack && opennextjs-cloudflare build --skipBuild --skipWranglerConfigCheck && opennextjs-cloudflare populateCache local",
    "start": "next start -p 3000",
    "preview": "opennextjs-cloudflare preview",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.17",
    "@fontsource-variable/inter": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@opennextjs/cloudflare": "^1.20.11",
    "@tursodatabase/api": "^1.9.2",
    "drizzle-orm": "^0.45.4",
    "md5": "^2.3.0",
    "next": "16.3.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svix": "^1.99.1"
  },
  "devDependencies": {
    "@types/md5": "^2.3.5",
    "@types/node": "^24.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.0"
  }
}
